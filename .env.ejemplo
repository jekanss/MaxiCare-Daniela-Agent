# Copia este archivo a `.env` y completa los valores reales. `.env` NUNCA se sube al
# repositorio -- ya está en `.gitignore`.

# =========================================================================================
# Variables que lee el SDK (`openai-agents`) directamente del entorno del proceso
# =========================================================================================

# Obligatoria: el único secreto real que el SDK lee del entorno.
OPENAI_API_KEY=reemplaza-esto-con-tu-clave

# Opcionales: identidad de cuenta, no son secretos, pero tampoco se hardcodean -- cambian
# entre clientes o entre entornos (desarrollo/producción) igual que la clave.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Opcionales: solo si el proyecto conecta a un gateway propio en vez de la API pública de
# OpenAI. Déjalas vacías o coméntalas si no aplica.
OPENAI_BASE_URL=
OPENAI_WEBSOCKET_BASE_URL=

# =========================================================================================
# Variables del proyecto MaxiCare -- no las lee el SDK, las lee `config.py`
# =========================================================================================

# Neon Postgres (`restricciones.stack_obligatorio`). Formato de cadena de Neon:
#   postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/basedatos?sslmode=require
# `sslmode=require` no es opcional: Neon rechaza conexiones sin TLS.
MAXICARE_DATABASE_URL=

# WhatsApp Business API. Las credenciales ya están en poder del dueño del proyecto.
MAXICARE_WHATSAPP_TOKEN=
MAXICARE_WHATSAPP_PHONE_NUMBER_ID=
MAXICARE_WHATSAPP_VERIFY_TOKEN=

# Telegram: la consola de decisión del equipo y el destino de los archivos de pacientes.
MAXICARE_TELEGRAM_BOT_TOKEN=
MAXICARE_TELEGRAM_CHAT_DOCTORES=

# Google Calendar. La cuenta de servicio va en base64, NO como ruta a un archivo: así el
# despliegue no tiene que copiar un JSON al VPS ni acertarle a los permisos del archivo.
#
#   python -c "import base64,json,sys; print(base64.b64encode(json.dumps(json.load(open(sys.argv[1])),separators=(',',':')).encode()).decode())" cuenta-de-servicio.json
#
# Un `.env` es UNA LÍNEA POR VARIABLE: pegar el JSON tal cual deja la variable valiendo `{`
# y el resto del archivo interpretado como variables basura. Pasó de verdad.
#
# El CALENDAR_ID es el correo del calendario. Y el paso que casi todo el mundo olvida:
# compartir ese calendario CON el `client_email` de la cuenta de servicio (termina en
# `.iam.gserviceaccount.com`) dando «Hacer cambios en los eventos». Sin eso la
# autenticación funciona perfecto y el calendario se ve vacío.
MAXICARE_GOOGLE_SA_B64=
MAXICARE_GOOGLE_CALENDAR_ID=

# Identificador del modelo. El plan fija la CLASE (general, con visión para el lector de
# archivos); el identificador exacto se confirma contra el catálogo del proveedor, porque
# `Agent(model=...)` acepta cualquier string y el SDK no valida que exista.
MAXICARE_MODELO_DANIELA=
MAXICARE_MODELO_LECTOR=

# Interfaz web (fase 5). Con este secreto se firma la cookie de sesion del panel.
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotarlo cierra TODAS las sesiones abiertas de golpe, que es la unica forma de invalidar
# un token ya firmado. Minimo 32 caracteres; sin el, el panel se apaga con un 503 y el
# webhook de WhatsApp sigue funcionando.
MAXICARE_SECRETO_SESION=
# Ponlo en 1 SOLO en local: http://localhost no acepta una cookie marcada `Secure`.
# En el VPS va detras de Traefik, que sirve HTTPS, y tiene que quedar vacio o en 0.
MAXICARE_COOKIE_INSEGURA=

# El freno de mano de Daniela en WhatsApp. Vacia o con cualquier valor que no sea `0`,
# Daniela CONTESTA: es el default, y es lo que pidio la clinica --nadie deberia tener que
# desplegar nada para que su asistente responda--.
#
# Con `MAXICARE_DANIELA_RESPONDE=0` el webhook sigue haciendo exactamente lo que lleva meses
# haciendo: registra el mensaje del paciente y le reenvia el archivo a los doctores por
# Telegram. Lo unico que se apaga es la respuesta al paciente.
#
# Existe para eso: poder callarla en diez segundos --una variable y un reinicio-- sin tocar
# el repositorio y sin apagar el servicio, que es lo que dejaria a los doctores sin recibir
# radiografias.
MAXICARE_DANIELA_RESPONDE=
