# Copia este archivo a `.env` y completa los valores reales. `.env` NUNCA se sube al
# repositorio -- ya está en `.gitignore`.

# =========================================================================================
# Variables que lee el SDK (`openai-agents`) directamente del entorno del proceso
# =========================================================================================

# Obligatoria: el único secreto real que el SDK lee del entorno.
OPENAI_API_KEY=reemplaza-esto-con-tu-clave

# Opcionales: identidad de cuenta, no son secretos, pero tampoco se hardcodean -- cambian
# entre clientes o entre entornos (desarrollo/producción) igual que la clave.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Opcionales: solo si el proyecto conecta a un gateway propio en vez de la API pública de
# OpenAI. Déjalas vacías o coméntalas si no aplica.
OPENAI_BASE_URL=
OPENAI_WEBSOCKET_BASE_URL=

# =========================================================================================
# Variables del proyecto MaxiCare -- no las lee el SDK, las lee `config.py`
# =========================================================================================

# Neon Postgres (`restricciones.stack_obligatorio`). Formato de cadena de Neon:
#   postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/basedatos?sslmode=require
# `sslmode=require` no es opcional: Neon rechaza conexiones sin TLS.
MAXICARE_DATABASE_URL=

# WhatsApp Business API. Las credenciales ya están en poder del dueño del proyecto.
MAXICARE_WHATSAPP_TOKEN=
MAXICARE_WHATSAPP_PHONE_NUMBER_ID=
MAXICARE_WHATSAPP_VERIFY_TOKEN=

# Con este secreto Meta firma cada POST al webhook, y esa firma es LO ÚNICO que distingue un
# webhook de Meta de uno de cualquiera que haya adivinado la URL, que es pública.
#
# Va SIN el prefijo `MAXICARE_` a propósito: es el nombre que le da Meta en la consola de
# desarrolladores (App > Configuración > Básica > Clave secreta de la aplicación), y así se
# reconoce al copiarlo de allí sin tener que traducir nada.
#
# Dejarla vacía no abre un agujero --`ingesta.firma_valida` falla cerrado: sin secreto no
# valida nada y rechaza--. Lo que provoca es peor de diagnosticar: un despliegue nuevo que
# responde 403 a TODOS los webhooks de Meta, con los doctores sin recibir una sola
# radiografía y sin nada en la pantalla que diga por qué. `/salud` la lista entre las
# obligatorias justo para que eso se vea antes de que pase.
WHATSAPP_APP_SECRET=

# Telegram: la consola de decisión del equipo y el destino de los archivos de pacientes.
MAXICARE_TELEGRAM_BOT_TOKEN=
MAXICARE_TELEGRAM_CHAT_DOCTORES=
# El secreto del webhook de Telegram, que es lo que hace funcionar el relevo (el boton
# «Hablar yo con el paciente»). Sin el, /webhook/telegram devuelve 403 a todo: ese endpoint
# es la unica puerta por la que algo externo puede hacer que el bot le escriba al WhatsApp
# de un paciente, asi que vacio significa CERRADO.
#   uv run python scripts/configurar_webhook_telegram.py --url https://tu.dominio/webhook/telegram
# lo genera, lo registra en Telegram y te dice que linea pegar aqui.
MAXICARE_TELEGRAM_WEBHOOK_SECRET=

# El nombre EXACTO de la plantilla de recordatorio de citas, aprobada en el Business Manager
# de Meta. Es la unica forma de escribirle a un paciente FUERA de la ventana de 24 horas, que
# es donde cae casi siempre el recordatorio de la vispera.
#
# Vacia -su default- apaga el ENVIO sin apagar la DECISION: el despachador sigue leyendo la
# cola, corriendo las siete guardas y anotando anulaciones y aplazamientos, y no manda un
# solo WhatsApp. Es lo que permite comprobar en produccion que decide bien antes de arriesgar
# un mensaje real.
MAXICARE_PLANTILLA_RECORDATORIO=

# El codigo de idioma EXACTO con el que esa traduccion quedo registrada, y gobierna las
# CUATRO plantillas (recordatorio + las tres de reactivacion de abajo), no solo la de
# recordatorio -pese al nombre de la variable, que se conserva tal cual porque ya esta en el
# .env del VPS-. Vacia usa `es`.
#
# Tiene que coincidir al caracter con lo que diga el Business Manager: una plantilla creada
# como `es_CO` o `es_MX` NO acepta `es`, y Meta rechaza el envio entero con el error 132001
# ("template name does not exist in the translation"). LAS CUATRO plantillas tienen que estar
# registradas con este MISMO codigo: la que no lo este falla el 100% de sus envios, y como la
# fila se marca ANTES de enviar (no negociable 21) cada una se pierde para siempre. Se
# comprueba contra la consola de Meta y no se supone.
MAXICARE_PLANTILLA_RECORDATORIO_IDIOMA=

# Las tres plantillas de REACTIVACION (sin agendar, cita cancelada, no asistio). Ninguna esta
# aprobada por Meta todavia -PENDIENTE, literal-, y las tres van vacias a proposito: es el
# mismo modo de comprobacion que MAXICARE_PLANTILLA_RECORDATORIO, y aqui es ademas el estado
# normal hasta que Meta las apruebe. El despachador decide igual sobre esos tipos -guardas,
# anulaciones, aplazamientos- y la fila se queda pendiente sin marcarse ni perderse.
# Los nombres exactos que hay que pedirle a Meta estan en docs/plantillas-meta-reactivacion.md.
MAXICARE_PLANTILLA_SIN_AGENDAR=
MAXICARE_PLANTILLA_CANCELADA=
MAXICARE_PLANTILLA_NO_ASISTIO=

# El interruptor de panico de la reactivacion (regla 10). `0` APAGA DE VERDAD, y apaga las DOS
# mitades: el barrido deja de encolar gente nueva -ni siquiera abre conexion- y el despachador
# APLAZA lo que ya estaba encolado, sin anularlo ni marcarlo, asi que esas filas salen el dia
# que se vuelva a encender. Lo que sigue igual: los recordatorios de cita, la atencion y el
# relevo. Hay que redesplegar para cambiarlo: es una variable de entorno, no una perilla del
# panel. Vacio o cualquier otro valor lo deja encendido, como MAXICARE_DANIELA_RESPONDE.
MAXICARE_REACTIVACION=

# La politica de tratamiento de datos que ve el paciente en su primer mensaje.
# DEJALAS VACIAS: desde el 16/09/2026 la URL y la version viven en config.py
# (POLITICA_DATOS_URL / POLITICA_DATOS_VERSION), porque el documento es publico y el dia
# que cambia tiene que quedar en el historial de git, no en un VPS. Vacio aqui no apaga
# nada: _opcional cae al valor del codigo.
# Rellenarlas solo para pisar la URL en un entorno que no sea produccion. El literal
# PENDIENTE apaga el aviso entero.
MAXICARE_POLITICA_DATOS_URL=
MAXICARE_POLITICA_DATOS_VERSION=

# Google Calendar. La cuenta de servicio va en base64, NO como ruta a un archivo: así el
# despliegue no tiene que copiar un JSON al VPS ni acertarle a los permisos del archivo.
#
#   python -c "import base64,json,sys; print(base64.b64encode(json.dumps(json.load(open(sys.argv[1])),separators=(',',':')).encode()).decode())" cuenta-de-servicio.json
#
# Un `.env` es UNA LÍNEA POR VARIABLE: pegar el JSON tal cual deja la variable valiendo `{`
# y el resto del archivo interpretado como variables basura. Pasó de verdad.
#
# El CALENDAR_ID es el correo del calendario. Y el paso que casi todo el mundo olvida:
# compartir ese calendario CON el `client_email` de la cuenta de servicio (termina en
# `.iam.gserviceaccount.com`) dando «Hacer cambios en los eventos». Sin eso la
# autenticación funciona perfecto y el calendario se ve vacío.
MAXICARE_GOOGLE_SA_B64=
MAXICARE_GOOGLE_CALENDAR_ID=

# Identificador del modelo. El plan fija la CLASE (general, con visión para el lector de
# archivos); el identificador exacto se confirma contra el catálogo del proveedor, porque
# `Agent(model=...)` acepta cualquier string y el SDK no valida que exista.
#
# El EVALUADOR es el tercero, y es a propósito un modelo más barato que los otros dos: los
# guardrails con evaluador le hacen UNA pregunta cerrada por llamada, y pagar ahí el tier de
# Daniela sería 10x por exactamente lo mismo. Si se deja vacía cae al default de `config.py`.
MAXICARE_MODELO_DANIELA=
MAXICARE_MODELO_LECTOR=
MAXICARE_MODELO_EVALUADOR=

# Interfaz web (fase 5). Con este secreto se firma la cookie de sesion del panel.
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotarlo cierra TODAS las sesiones abiertas de golpe, que es la unica forma de invalidar
# un token ya firmado. Minimo 32 caracteres; sin el, el panel se apaga con un 503 y el
# webhook de WhatsApp sigue funcionando.
MAXICARE_SECRETO_SESION=
# Ponlo en 1 SOLO en local: http://localhost no acepta una cookie marcada `Secure`.
# En el VPS va detras de Traefik, que sirve HTTPS, y tiene que quedar vacio o en 0.
MAXICARE_COOKIE_INSEGURA=

# El freno de mano de Daniela en WhatsApp. Vacia o con cualquier valor que no sea `0`,
# Daniela CONTESTA: es el default, y es lo que pidio la clinica --nadie deberia tener que
# desplegar nada para que su asistente responda--.
#
# Con `MAXICARE_DANIELA_RESPONDE=0` el webhook sigue haciendo exactamente lo que lleva meses
# haciendo: registra el mensaje del paciente y le reenvia el archivo a los doctores por
# Telegram. Lo unico que se apaga es la respuesta al paciente.
#
# Existe para eso: poder callarla en diez segundos --una variable y un reinicio-- sin tocar
# el repositorio y sin apagar el servicio, que es lo que dejaria a los doctores sin recibir
# radiografias.
MAXICARE_DANIELA_RESPONDE=

# Apaga el informe automatico de «sin resolver». La captura sigue funcionando.
MAXICARE_ANALIZAR_SIN_RESOLVER=1

# ------------------------------------------------------------------------------------------
# Numeros que pueden resetearse con /clearstate  (opcional, VACIA por defecto)
# ------------------------------------------------------------------------------------------
#
# Separados por coma. Uno de estos numeros puede escribirle `/clearstate` a Daniela por
# WhatsApp y quedar, para ella, como un numero que nunca ha escrito: se borran su paciente,
# sus conversaciones, sus mensajes, sus citas --incluidos los eventos en Google Calendar-- y
# su tema de Telegram. Sirve para probar una conversacion entera desde cero sin estrenar una
# linea de telefono.
#
# DEJARLA VACIA APAGA EL COMANDO PARA TODO EL MUNDO, y ese es el default a proposito: el
# texto `/clearstate` de cualquier otro numero llega a Daniela como un mensaje normal. En
# produccion no hace falta tocar esta variable nunca.
#
# El borrado es inmediato y no se puede deshacer. Se compara por digitos, asi que da igual
# como se escriba el numero: +57 300 123 4567 y 573001234567 son el mismo.
#
# Varios numeros van separados por coma:
#   MAXICARE_TELEFONOS_PRUEBA=573001110001,573001110002
#
# Esta variable NO hace falta para el chat de pruebas del panel: ahi `/clearstate` funciona
# para cualquiera que tenga sesion abierta, porque cada uno borra su propio carril
# (`web-<usuario>`) dentro del esquema `pruebas_web` y no hay ningun numero real de por medio.
MAXICARE_TELEFONOS_PRUEBA=

# ------------------------------------------------------------------------------------------
# Aviso a los doctores de cada cita nueva  (opcional, APAGADO por defecto)
# ------------------------------------------------------------------------------------------
#
# El nombre EXACTO de la plantilla de Meta que avisa a los doctores por WhatsApp cuando
# Daniela agenda una cita: nombre del paciente, su telefono, de que es la cita, la fecha y la
# hora. Tiene que ser plantilla y no un texto libre porque los doctores nunca le escriben a
# Daniela: estan fuera de la ventana de 24 horas de Meta SIEMPRE, no a veces.
#
# Vacia -su default- apaga el ENVIO sin apagar la DECISION: la cita se crea igual y queda en
# el log a quien se le habria avisado y con que datos. Mismo patron que
# MAXICARE_PLANTILLA_RECORDATORIO, y por la misma razon: esto se puede desplegar hoy, con la
# plantilla todavia sin aprobar, sin que salga un solo mensaje.
MAXICARE_PLANTILLA_CITA_NUEVA=

# El codigo de idioma EXACTO con el que esa traduccion quedo registrada. Vacia usa `es`.
# Misma trampa que la del recordatorio: una plantilla creada como `es_CO` NO acepta `es` y
# Meta rechaza el envio entero con el error 132001.
MAXICARE_PLANTILLA_CITA_NUEVA_IDIOMA=

# La plantilla que avisa de un MOVIMIENTO de agenda: el paciente confirmo su cita, dijo que
# no podra asistir, o la cambio de hora. Es UNA sola para los tres casos, con cinco huecos:
#
#   {{1}} asunto  {{2}} nombre  {{3}} telefono  {{4}} tratamiento  {{5}} cuando
#
# El asunto es un DATO y no parte del texto aprobado ("Confirmo su cita" / "No podra
# asistir" / "Cambio su cita"), que es lo que permite cambiar la redaccion con un commit en
# vez de con un tramite de 24 h. Las cinco variables van en el BODY: `enviar_plantilla` solo
# manda ese componente, asi que una variable en el header la rechaza Meta con un 132000.
#
# Vacia -su default- apaga el ENVIO sin apagar la DECISION, igual que la de arriba.
MAXICARE_PLANTILLA_MOVIMIENTO_AGENDA=

# El codigo de idioma EXACTO de esa traduccion. Vacia usa `es`. Misma trampa del 132001.
MAXICARE_PLANTILLA_MOVIMIENTO_AGENDA_IDIOMA=

# A que numeros va ese aviso, separados por coma y en formato internacional sin `+`.
# Vacia usa los de `config.WHATSAPP_DOCTORES`, que estan en el codigo a proposito: no son un
# secreto, y un despliegue que olvide una variable no puede significar que los doctores dejen
# de enterarse de las citas.
MAXICARE_WHATSAPP_DOCTORES=


# ==========================================================================================
# El perimetro: que un desconocido no pueda quemar el saldo
# ==========================================================================================
#
# El numero de WhatsApp de una clinica es publico -tiene que serlo- asi que la firma HMAC de
# Meta, que es lo unico que protege el webhook, NO distingue a un paciente de alguien que
# quiere gastar el saldo de OpenAI: los dos entran por la puerta principal y los dos vienen
# firmados. Estas variables son el techo.
#
# TODAS son opcionales y TODAS traen un default que ya protege: un `.env` anterior a esta
# fase arranca con el freno puesto sin tocar nada. Los numeros estan calibrados contra el
# volumen real del 21/09/2026 -4 conversaciones y 11 turnos al dia- y van muy por encima del
# uso legitimo a proposito: un freno que muerde a un paciente real es peor que el ataque que
# evita.

# Mensajes de UN mismo numero en una hora antes de que Daniela deje de llamar al modelo. Al
# pasarse, el paciente recibe una frase fija y el doctor UN aviso por ventana -no uno por
# mensaje, que seria la misma inundacion servida por la propia defensa-. Vacia usa 40.
MAXICARE_CUOTA_MENSAJES_HORA=

# Archivos de UN mismo numero en un dia antes de dejar de LEERLOS con el modelo. El archivo
# le sigue llegando al doctor siempre: eso no lo apaga nada. Lo que se apaga es la llamada al
# modelo caro. Es la cuota que mas importa, porque el lector corre fuera del bufer y fuera del
# candado por telefono: N archivos son N llamadas en paralelo. Vacia usa 12.
MAXICARE_CUOTA_ARCHIVOS_DIA=

# A `1`, las cuotas CUENTAN y AVISAN pero no cortan a nadie.
#
# Existe porque con 4 conversaciones al dia todavia no se sabe cual es el uso normal de esta
# clinica, y cualquier umbral es una corazonada. Esto permite encender la medicion hoy y el
# corte cuando haya datos para elegir el numero. Vacia usa `0`, o sea: corta.
#
# ARRANCA EN `1`, Y ES UNA RECOMENDACION, NO UN DEFAULT: el default del codigo sigue siendo
# cortar -el lado que protege- y es esta linea la que pide observar primero. El orden importa:
# encender el corte con umbrales que nadie ha medido es descubrir el limite con un paciente
# real del otro lado. Con `1` durante los primeros dias de volumen, los numeros salen de
# `consumo_modelo` y de los avisos del General; entonces se fijan las cuotas y esto pasa a `0`.
MAXICARE_CUOTA_MODO_OBSERVACION=1

# Lecturas de archivo simultaneas en TODO el proceso. No es una cuota por telefono: es el
# techo de llamadas concurrentes al modelo caro, y lo que impide que N archivos grandes esten
# a la vez en memoria en un contenedor de un solo worker. Vacia usa 3.
MAXICARE_LECTORES_CONCURRENTES=

# El segundo freno de mano, y es INDEPENDIENTE de MAXICARE_DANIELA_RESPONDE a proposito.
#
# Con `0`, los archivos siguen llegandole al doctor igual y lo unico que se corta es la
# llamada al modelo que los lee. Son dos emergencias distintas: «Daniela dice tonterias» se
# apaga con MAXICARE_DANIELA_RESPONDE, «el lector se esta comiendo el saldo» con esta. Y
# aquel interruptor promete por escrito que el doctor sigue recibiendo sus archivos y sus
# lecturas como siempre. Vacia usa `1`, o sea: lee.
MAXICARE_LEER_ARCHIVOS=

# El TERCER freno de mano, y tampoco cuelga de ninguno de los otros dos.
#
# Con `0`, la nota de voz le llega al doctor igual y Daniela vuelve a lo de antes: avisa de
# que llego y le pide al paciente que se lo escriba. La tentacion era colgarlo de
# MAXICARE_LEER_ARCHIVOS, que ya significa «no pagues modelos por archivos», y seria el error
# simetrico del que ese interruptor evita: aquel apaga algo que es del DOCTOR y promete no
# tocar lo del paciente; esto es del PACIENTE. Vacia usa `1`, o sea: transcribe.
MAXICARE_TRANSCRIBIR_AUDIO=

# Notas de voz de UN mismo numero en un dia antes de dejar de TRANSCRIBIRLAS. El audio le
# sigue llegando al doctor siempre. Cuenta APARTE de MAXICARE_CUOTA_ARCHIVOS_DIA a proposito:
# son gastos de ordenes de magnitud distintos, y con un contador compartido veinte notas de
# voz se comerian la cuota de la serie de radiografias que viene detras. Vacia usa 40.
MAXICARE_CUOTA_AUDIOS_DIA=

# El modelo que pasa el audio a texto. De los cuatro de la cuenta, `gpt-transcribe` es el
# UNICO que sirve: los dos `gpt-4o-transcribe` devuelven algo que parece espanol y no lo es,
# que es peor que no transcribir. Quien lo cambie corre `scripts/probar_transcripcion.py` y
# LEE las frases. Vacia usa gpt-transcribe.
MAXICARE_MODELO_TRANSCRIPTOR=

# Dolares al dia a partir de los cuales el General recibe UN aviso. No corta nada: avisa.
# Cortar por gasto dejaria a los pacientes sin respuesta por una cifra, y esa decision es de
# la clinica y no del codigo. Referencia medida: una conversacion de agendamiento completa de
# 6 turnos cuesta 0,095 USD. Vacia usa 5.0, que son ~50 conversaciones al dia.
MAXICARE_ALERTA_GASTO_DIARIO_USD=

# Hasta donde se le pasa al modelo lo que escribio el paciente. Por encima se TRUNCA con una
# marca visible, nunca se rechaza: rechazar deja al paciente sin respuesta.
#
# Existe por un fallo silencioso: `guardrails._preguntar` atrapa toda excepcion y devuelve
# «no dispara» -decision correcta, un sistema mudo no protege a nadie- asi que una entrada lo
# bastante larga para reventar el contexto del evaluador DESACTIVA el guardrail de inyeccion
# para ese turno, dejando solo un log.error. El tope quita la causa. Vacia usa 8000, que es
# el doble de lo que el chat del panel ya exigia.
MAXICARE_TOPE_ENTRADA_CARACTERES=

# Megabytes por encima de los cuales un archivo ni se descarga: se mira el `file_size` que
# declara Meta ANTES de bajar un solo byte. Sin esto, el archivo se cargaba entero en RAM y
# se re-serializaba hacia Telegram -dos copias por archivo- sin limite de concurrencia.
#
# Vacia usa 55, elegido para NO perder nada que hoy funcione: Telegram rechaza por encima de
# 50 MB, asi que un archivo que cruce este tope ya estaba fallando. Cambia DONDE falla, no si
# falla. Bajarlo costaria radiografias legitimas.
MAXICARE_TOPE_DESCARGA_MB=
