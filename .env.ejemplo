# Copia este archivo a `.env` y completa los valores reales. `.env` NUNCA se sube al
# repositorio -- ya está en `.gitignore`.

# =========================================================================================
# Variables que lee el SDK (`openai-agents`) directamente del entorno del proceso
# =========================================================================================

# Obligatoria: el único secreto real que el SDK lee del entorno.
OPENAI_API_KEY=reemplaza-esto-con-tu-clave

# Opcionales: identidad de cuenta, no son secretos, pero tampoco se hardcodean -- cambian
# entre clientes o entre entornos (desarrollo/producción) igual que la clave.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Opcionales: solo si el proyecto conecta a un gateway propio en vez de la API pública de
# OpenAI. Déjalas vacías o coméntalas si no aplica.
OPENAI_BASE_URL=
OPENAI_WEBSOCKET_BASE_URL=

# =========================================================================================
# Variables del proyecto MaxiCare -- no las lee el SDK, las lee `config.py`
# =========================================================================================

# Neon Postgres (`restricciones.stack_obligatorio`). Formato de cadena de Neon:
#   postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/basedatos?sslmode=require
# `sslmode=require` no es opcional: Neon rechaza conexiones sin TLS.
MAXICARE_DATABASE_URL=

# WhatsApp Business API. Las credenciales ya están en poder del dueño del proyecto.
MAXICARE_WHATSAPP_TOKEN=
MAXICARE_WHATSAPP_PHONE_NUMBER_ID=
MAXICARE_WHATSAPP_VERIFY_TOKEN=

# Con este secreto Meta firma cada POST al webhook, y esa firma es LO ÚNICO que distingue un
# webhook de Meta de uno de cualquiera que haya adivinado la URL, que es pública.
#
# Va SIN el prefijo `MAXICARE_` a propósito: es el nombre que le da Meta en la consola de
# desarrolladores (App > Configuración > Básica > Clave secreta de la aplicación), y así se
# reconoce al copiarlo de allí sin tener que traducir nada.
#
# Dejarla vacía no abre un agujero --`ingesta.firma_valida` falla cerrado: sin secreto no
# valida nada y rechaza--. Lo que provoca es peor de diagnosticar: un despliegue nuevo que
# responde 403 a TODOS los webhooks de Meta, con los doctores sin recibir una sola
# radiografía y sin nada en la pantalla que diga por qué. `/salud` la lista entre las
# obligatorias justo para que eso se vea antes de que pase.
WHATSAPP_APP_SECRET=

# Telegram: la consola de decisión del equipo y el destino de los archivos de pacientes.
MAXICARE_TELEGRAM_BOT_TOKEN=
MAXICARE_TELEGRAM_CHAT_DOCTORES=
# El secreto del webhook de Telegram, que es lo que hace funcionar el relevo (el boton
# «Hablar yo con el paciente»). Sin el, /webhook/telegram devuelve 403 a todo: ese endpoint
# es la unica puerta por la que algo externo puede hacer que el bot le escriba al WhatsApp
# de un paciente, asi que vacio significa CERRADO.
#   uv run python scripts/configurar_webhook_telegram.py --url https://tu.dominio/webhook/telegram
# lo genera, lo registra en Telegram y te dice que linea pegar aqui.
MAXICARE_TELEGRAM_WEBHOOK_SECRET=

# El nombre EXACTO de la plantilla de recordatorio de citas, aprobada en el Business Manager
# de Meta. Es la unica forma de escribirle a un paciente FUERA de la ventana de 24 horas, que
# es donde cae casi siempre el recordatorio de la vispera.
#
# Vacia -su default- apaga el ENVIO sin apagar la DECISION: el despachador sigue leyendo la
# cola, corriendo las siete guardas y anotando anulaciones y aplazamientos, y no manda un
# solo WhatsApp. Es lo que permite comprobar en produccion que decide bien antes de arriesgar
# un mensaje real.
MAXICARE_PLANTILLA_RECORDATORIO=

# El codigo de idioma EXACTO con el que esa traduccion quedo registrada. Vacia usa `es`.
#
# Tiene que coincidir al caracter con lo que diga el Business Manager: una plantilla creada
# como `es_CO` o `es_MX` NO acepta `es`, y Meta rechaza el envio entero con el error 132001
# ("template name does not exist in the translation"). Es un fallo del 100% de los envios,
# asi que se comprueba contra la consola de Meta y no se supone.
MAXICARE_PLANTILLA_RECORDATORIO_IDIOMA=

# Las tres plantillas de REACTIVACION (sin agendar, cita cancelada, no asistio). Ninguna esta
# aprobada por Meta todavia -PENDIENTE, literal-, y las tres van vacias a proposito: es el
# mismo modo de comprobacion que MAXICARE_PLANTILLA_RECORDATORIO, y aqui es ademas el estado
# normal hasta que Meta las apruebe. El despachador decide igual sobre esos tipos -guardas,
# anulaciones, aplazamientos- y la fila se queda pendiente sin marcarse ni perderse.
# Los nombres exactos que hay que pedirle a Meta estan en docs/plantillas-meta-reactivacion.md.
MAXICARE_PLANTILLA_SIN_AGENDAR=
MAXICARE_PLANTILLA_CANCELADA=
MAXICARE_PLANTILLA_NO_ASISTIO=

# El interruptor de panico de la reactivacion. `0` apaga el BARRIDO entero sin redesplegar:
# deja de encolar gente nueva y todo lo demas -recordatorios de cita, atencion, relevo- sigue
# igual. Vacio o cualquier otro valor lo deja encendido, como MAXICARE_DANIELA_RESPONDE.
MAXICARE_REACTIVACION=

# La politica de tratamiento de datos que ve el paciente en su primer mensaje.
# DEJALAS VACIAS: desde el 16/09/2026 la URL y la version viven en config.py
# (POLITICA_DATOS_URL / POLITICA_DATOS_VERSION), porque el documento es publico y el dia
# que cambia tiene que quedar en el historial de git, no en un VPS. Vacio aqui no apaga
# nada: _opcional cae al valor del codigo.
# Rellenarlas solo para pisar la URL en un entorno que no sea produccion. El literal
# PENDIENTE apaga el aviso entero.
MAXICARE_POLITICA_DATOS_URL=
MAXICARE_POLITICA_DATOS_VERSION=

# Google Calendar. La cuenta de servicio va en base64, NO como ruta a un archivo: así el
# despliegue no tiene que copiar un JSON al VPS ni acertarle a los permisos del archivo.
#
#   python -c "import base64,json,sys; print(base64.b64encode(json.dumps(json.load(open(sys.argv[1])),separators=(',',':')).encode()).decode())" cuenta-de-servicio.json
#
# Un `.env` es UNA LÍNEA POR VARIABLE: pegar el JSON tal cual deja la variable valiendo `{`
# y el resto del archivo interpretado como variables basura. Pasó de verdad.
#
# El CALENDAR_ID es el correo del calendario. Y el paso que casi todo el mundo olvida:
# compartir ese calendario CON el `client_email` de la cuenta de servicio (termina en
# `.iam.gserviceaccount.com`) dando «Hacer cambios en los eventos». Sin eso la
# autenticación funciona perfecto y el calendario se ve vacío.
MAXICARE_GOOGLE_SA_B64=
MAXICARE_GOOGLE_CALENDAR_ID=

# Identificador del modelo. El plan fija la CLASE (general, con visión para el lector de
# archivos); el identificador exacto se confirma contra el catálogo del proveedor, porque
# `Agent(model=...)` acepta cualquier string y el SDK no valida que exista.
#
# El EVALUADOR es el tercero, y es a propósito un modelo más barato que los otros dos: los
# guardrails con evaluador le hacen UNA pregunta cerrada por llamada, y pagar ahí el tier de
# Daniela sería 10x por exactamente lo mismo. Si se deja vacía cae al default de `config.py`.
MAXICARE_MODELO_DANIELA=
MAXICARE_MODELO_LECTOR=
MAXICARE_MODELO_EVALUADOR=

# Interfaz web (fase 5). Con este secreto se firma la cookie de sesion del panel.
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotarlo cierra TODAS las sesiones abiertas de golpe, que es la unica forma de invalidar
# un token ya firmado. Minimo 32 caracteres; sin el, el panel se apaga con un 503 y el
# webhook de WhatsApp sigue funcionando.
MAXICARE_SECRETO_SESION=
# Ponlo en 1 SOLO en local: http://localhost no acepta una cookie marcada `Secure`.
# En el VPS va detras de Traefik, que sirve HTTPS, y tiene que quedar vacio o en 0.
MAXICARE_COOKIE_INSEGURA=

# El freno de mano de Daniela en WhatsApp. Vacia o con cualquier valor que no sea `0`,
# Daniela CONTESTA: es el default, y es lo que pidio la clinica --nadie deberia tener que
# desplegar nada para que su asistente responda--.
#
# Con `MAXICARE_DANIELA_RESPONDE=0` el webhook sigue haciendo exactamente lo que lleva meses
# haciendo: registra el mensaje del paciente y le reenvia el archivo a los doctores por
# Telegram. Lo unico que se apaga es la respuesta al paciente.
#
# Existe para eso: poder callarla en diez segundos --una variable y un reinicio-- sin tocar
# el repositorio y sin apagar el servicio, que es lo que dejaria a los doctores sin recibir
# radiografias.
MAXICARE_DANIELA_RESPONDE=

# Apaga el informe automatico de «sin resolver». La captura sigue funcionando.
MAXICARE_ANALIZAR_SIN_RESOLVER=1

# ------------------------------------------------------------------------------------------
# Numeros que pueden resetearse con /clearstate  (opcional, VACIA por defecto)
# ------------------------------------------------------------------------------------------
#
# Separados por coma. Uno de estos numeros puede escribirle `/clearstate` a Daniela por
# WhatsApp y quedar, para ella, como un numero que nunca ha escrito: se borran su paciente,
# sus conversaciones, sus mensajes, sus citas --incluidos los eventos en Google Calendar-- y
# su tema de Telegram. Sirve para probar una conversacion entera desde cero sin estrenar una
# linea de telefono.
#
# DEJARLA VACIA APAGA EL COMANDO PARA TODO EL MUNDO, y ese es el default a proposito: el
# texto `/clearstate` de cualquier otro numero llega a Daniela como un mensaje normal. En
# produccion no hace falta tocar esta variable nunca.
#
# El borrado es inmediato y no se puede deshacer. Se compara por digitos, asi que da igual
# como se escriba el numero: +57 300 123 4567 y 573001234567 son el mismo.
#
# Varios numeros van separados por coma:
#   MAXICARE_TELEFONOS_PRUEBA=573001110001,573001110002
#
# Esta variable NO hace falta para el chat de pruebas del panel: ahi `/clearstate` funciona
# para cualquiera que tenga sesion abierta, porque cada uno borra su propio carril
# (`web-<usuario>`) dentro del esquema `pruebas_web` y no hay ningun numero real de por medio.
MAXICARE_TELEFONOS_PRUEBA=
